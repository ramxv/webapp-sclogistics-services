---
import { Label } from "@/ui/label";
import { Textarea } from "@/ui/textarea";
import { actions } from "astro:actions";
import logo from "@/assets/images/logo/SCLogisticsPNG.png";
import { isInputError } from "astro:actions";

const result = Astro.getActionResult(actions.send);
const inputError = isInputError(result?.error) ? result.error.fields : {};
---

<section class="mt-0 w-full flex flex-col items-start justify-center px-4 py-6 relative overflow-hidden" id="contact">

  <section class="mt-0 w-full flex-col justify-end px-3 md:flex md:flex-row-reverse pb-6 md:gap-4 md:my-12 md:ml-48">
    <div class="relative mt-4 z-20">
      <h2 class="font-heading font-extrabold text-5xl text-white text-center break-normal opacity-15 md:text-left md:text-6xl"> Contáctanos </h2>
      <h4 class="font-heading font-bold text-4xl text-white text-center absolute inset-x-0 bottom-0 md:text-left md:text-5xl md:absolute md:left-12 md:bottom-0"> Contáctanos </h4>
    </div>
  </section>
  
  <div class="absolute z-5 w-1/3 h-full left-0 overflow-hidden md:w-1/4 md:h-full bg-primary"></div>
  <div class="absolute z-5 w-1/2 h-full rotate-25 left-5 overflow-hidden md:w-1/2 md:h-full md:rotate-30 bg-primary"></div>
  <div class="absolute z-0 w-7/12 h-full rotate-30 md:w-7/12 md:h-full md:rotate-25 bg-primary-accent"></div>
  <img src={logo.src} alt="" class="transition-all fade-in-50 duration-500 h-0 md:h-0 lg:h-full z-10 absolute right-0 overflow-hidden drop-shadow-2xl/50"/>

  <!-- Form Section -->
  <div class="w-full max-w-2xl bg-white/90 backdrop-blur-sm rounded-xl shadow-lg p-6 md:ml-15 md:p-8 md:relative z-20 md:z-20">
    <form action={actions.send} method="POST" class="flex flex-col gap-4" >
      <Label htmlFor="completeName">Nombre Completo</Label>
      <input placeholder="e.g. Nombre Appellido" id="completeName" type="text" name="completeName" autocomplete="off" aria-describedby="error" />
      {inputError.completeName && <p id="error" class="text-red-700">El nombre es obligatorio</p>}

      <Label htmlFor="gmail">Correo Electrónico</Label>
      <input placeholder="e.g. micorreo@gmail.com" id="gmail" type="email" name="gmail" autocomplete="off" aria-describedby="error" />
      {inputError.gmail && <p id="error" class="text-red-700">El correo es obligatorio</p>}


      <Label htmlFor="subjectDescription">Asunto</Label>
      <input placeholder="e.g. Cotización de transporte" id="subjectDescription" type="text" name="subjectDescription" autocomplete="off" aria-describedby="error" />
      {inputError.subjectDescription && <p id="error" class="text-red-700">El asunto es obligatorio</p>}

      <Label htmlFor="description">Mensaje</Label>
      <Textarea id="description" name="description" />
      {inputError.description && <p id="error" class="text-red-700">El cuerpo del correo es obligatorio</p>}

      <button class="font-principal hover:cursor-pointer hover:bg-secondary/85 bg-secondary text-black">Enviar</button>
    </form>

  </div>


</section>

{result && (
  <script is:inline define:vars={{ result }}>
    window.actionResult = result;
  </script>
)}

<script>
  import { toast } from "sonner";

  // Use DOMContentLoaded for better compatibility
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', handleActionResult);
  } else {
    handleActionResult();
  }

  // Also listen for Astro page loads
  document.addEventListener('astro:page-load', handleActionResult);

  function handleActionResult() {
    const actionResult = (window as any).actionResult;

    // Always clean up the URL if it has action parameters
    const url = new URL(window.location.href);
    if (url.searchParams.has('_action')) {
      url.searchParams.delete('_action');
      window.history.replaceState({}, '', url.toString());
    }

    if (actionResult) {
      if (actionResult.error) {
        // Show validation errors as toast
        if (actionResult.error.fields) {
          const errors = Object.values(actionResult.error.fields).flat();
          errors.forEach((error: any) => {
            toast(error);
          });
        } else {
          toast('Error al enviar el mensaje. Por favor, intenta de nuevo.');
        }
      } else {
        toast('¡Mensaje enviado exitosamente!');
        const form = document.querySelector('form');
        if (form) {
          form.reset();
        }
      }
      // Clear the result to prevent showing again
      delete (window as any).actionResult;
    }
  }
</script>


